# Document store - MongoDB (local or Atlas)
# If mongodb+srv:// fails with "querySrv ECONNREFUSED", your Node DNS resolver
# cannot do SRV lookups - use the standard mongodb:// form from Atlas instead.
MONGODB_URI=mongodb://localhost:27017/salesmotion

# SQL store - Supabase (replaces the old SQLite file)
# Project Settings -> API: "Project URL" and the "service_role" secret
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- AI providers ----------------------------------------------------------
# Tried in order; the next one takes over when the one before hits its limit.
# Flip the order (or drop a name) to change which model does the work.
PROVIDER_ORDER=azure,groq,gemini
# How long a provider is skipped after a rate-limit before it is tried again.
PROVIDER_COOLDOWN_MS=60000

# Azure OpenAI - the primary. Portal -> your Azure OpenAI resource -> "Keys and
# Endpoint" for the first two; the deployment name is the one you typed in AI
# Foundry, which is usually NOT the model name.
# Use the resource ROOT. An AI Foundry project endpoint (.../api/projects/<name>)
# belongs to the @azure/ai-projects SDK and fails here with "API version not
# supported". Both .openai.azure.com and .services.ai.azure.com roots work.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=placeholder_get_from_azure_portal
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# The REST API version - NOT the model version shown beside the deployment.
# gpt-5 and the o-series need 2024-12-01-preview or later.
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Optional. Only labels the report and picks the parameter style - gpt-5/o-series
# take max_completion_tokens and no temperature, everything else takes max_tokens.
# The provider corrects itself on a 400 either way, so a wrong guess is not fatal.
AZURE_OPENAI_MODEL=

# Reasoning models only (gpt-5 / o-series). They spend the completion budget on
# thinking before writing, so a small pass can return nothing at all. EFFORT
# 'low' keeps that spend to ~64-128 tokens; RESERVE is added on top of whatever
# the caller asked for. Set EFFORT=default to let the model decide.
AZURE_REASONING_EFFORT=low
AZURE_REASONING_RESERVE=1024

# Groq (Get from https://console.groq.com - FREE)
GROQ_API_KEY=placeholder_get_from_groq
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini fallback (Get from https://aistudio.google.com/apikey - FREE)
# NOTE: a consumer Google AI Pro / One Premium subscription does NOT raise these
# limits. API quota comes from the key's Cloud project billing status.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# How much evidence each AI pass is given. The source block is repeated in every
# pass, so these are the main lever on prompt size.
#
# IMPORTANT: these are global, not per provider. The prompt is built before the
# failover chain picks a winner, so whatever fits Azure's window is also what
# Groq and Gemini are handed. Sized for Azure below; Gemini (1M window) copes,
# but Groq's free tier (12k tokens/min) will reject a prompt this large, which
# makes it a last resort rather than a working fallback. Drop back to the
# Groq-safe row if you need all three to serve equally.
#   azure-sized (current): 30 / 10 / 5 / 1200
#   groq-safe free tier:   8 / 3 / 2 / 140
#   original pre-limit:    26 / 8 / 4 / 320
MAX_NEWS_SOURCES=30
MAX_JOB_SOURCES=10
MAX_FILING_SOURCES=5
# News feeds only carry ~370 chars per article, but job descriptions run 5-10k
# and SEC filing excerpts 3k - this is what decides how much of those is read.
SOURCE_BODY_CHARS=1200

# --- SEC filing text -------------------------------------------------------
# Filings arrive as a title and a URL. These pull the actual document down and
# keep the leading prose, which is where a company states what it is spending on
# and worried about. Set SEC_ENRICH_FILINGS=0 to skip the fetch entirely.
SEC_ENRICH_FILINGS=5
SEC_EXCERPT_CHARS=3000

# NewsAPI (Get from https://newsapi.org - FREE)
NEWS_API_KEY=placeholder_get_from_newsapi

# Finnhub (Get from https://finnhub.io - FREE)
FINNHUB_API_KEY=placeholder_get_from_finnhub

# --- Logo.dev --------------------------------------------------------------
# Company suggestions in "Add an account": name -> homepage -> logo, across 50M+
# companies. Wikipedia and Wikidata only know the ones somebody wrote an article
# about, so without this a private prospect returns no suggestion at all and the
# rep has to type the name exactly.
#
# Both keys are on the same dashboard page (https://www.logo.dev - Dashboard ->
# API keys). They are different keys and both are needed:
#   SECRET (sk_...)      the Brand Search API. Server-side only - never ship it
#                        to the browser or commit it.
#   PUBLISHABLE (pk_...) the image CDN. It appears inside every logo URL, so it
#                        is public by design and safe to store on the company.
# Leave either blank to turn the integration off; the encyclopedia sources still
# answer the search box on their own.
LOGODEV_SECRET_KEY=
LOGODEV_PUBLISHABLE_KEY=

# --- Brandfetch ------------------------------------------------------------
# The same name -> homepage -> logo search as logo.dev, and one thing nothing
# else here has: firmographics for private companies. Its Brand API answers by
# domain with headcount, founding year, industry, the city and country the
# company operates from, and its own LinkedIn and Crunchbase pages - which is
# what a report cover needs and what Wikidata only has for the companies
# somebody wrote an article about.
#
# Both keys come from https://developers.brandfetch.com:
#   CLIENT_ID   Brand Search and the logo CDN. Public by design - it travels
#               inside the image URL the browser requests.
#   API_KEY     The Brand API. A bearer secret; never ship it to the browser.
# Either can be set on its own: the client id alone gives search and logos, the
# api key alone gives firmographics for accounts whose domain is already known.
BRANDFETCH_CLIENT_ID=
BRANDFETCH_API_KEY=

# NOTE: there is no email-domain allowlist any more. Access is decided by which
# subscribing organization owns the domain, set when a company registers via
# POST /api/auth/register-organization.

# JWT
# REQUIRED. The server refuses to boot if this is missing, still set to the
# placeholder below, or shorter than 32 characters — a weak signing key means
# anyone can forge a login token. Generate a real one with:
#   openssl rand -base64 48
JWT_SECRET=your-super-secret-key-change-in-production

# Server
PORT=5000
NODE_ENV=development

# Frontend URL
# Comma-separate to allow several origins. An entry may use a wildcard subdomain
# to cover Cloudflare Pages preview builds, which each get their own hostname:
#   https://salesmotion.pages.dev,https://*.salesmotion.pages.dev
# REQUIRED when NODE_ENV=production — without it the browser is blocked by CORS.
FRONTEND_URL=http://localhost:3000

# --- Rate limits -----------------------------------------------------------
# Set far above normal use; they exist to stop password guessing and to cap the
# AI spend a single client can trigger. Raise them here, no code change needed.
RATE_LIMIT_GLOBAL=600     # requests per IP per 15 min across /api
RATE_LIMIT_AUTH=30        # sign-in / sign-up attempts per IP per 15 min
RATE_LIMIT_REPORTS=40     # report requests per IP per hour

# --- Stuck report recovery -------------------------------------------------
# Reports finish in the background after the response is sent, so a restart or
# redeploy mid-run would otherwise leave one "pending" forever. Anything still
# pending after this long is marked failed so the user can re-run it. Keep the
# threshold comfortably above the slowest real run (~60s).
REPORT_STALE_AFTER_MS=900000      # 15 minutes
REPORT_SWEEP_INTERVAL_MS=300000   # check every 5 minutes

# Email (Optional - for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Log Level
LOG_LEVEL=debug
