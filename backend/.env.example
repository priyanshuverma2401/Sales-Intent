# Document store - MongoDB (local or Atlas)
# If mongodb+srv:// fails with "querySrv ECONNREFUSED", your Node DNS resolver
# cannot do SRV lookups - use the standard mongodb:// form from Atlas instead.
MONGODB_URI=mongodb://localhost:27017/salesmotion

# SQL store - Supabase (replaces the old SQLite file)
# Project Settings -> API: "Project URL" and the "service_role" secret
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq AI (Get from https://console.groq.com - FREE)
GROQ_API_KEY=placeholder_get_from_groq
GROQ_MODEL=llama-3.3-70b-versatile

# NewsAPI (Get from https://newsapi.org - FREE)
NEWS_API_KEY=placeholder_get_from_newsapi

# Finnhub (Get from https://finnhub.io - FREE)
FINNHUB_API_KEY=placeholder_get_from_finnhub

# NOTE: there is no email-domain allowlist any more. Access is decided by which
# subscribing organization owns the domain, set when a company registers via
# POST /api/auth/register-organization.

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# Server
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email (Optional - for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Log Level
LOG_LEVEL=debug
