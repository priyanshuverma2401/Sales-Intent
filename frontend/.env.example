# Base URL of the SalesMotion API.
#
# Local development: services/api.ts falls back to http://localhost:5000/api when
# this is unset, so you only need it when the backend lives somewhere else.
#
# Cloudflare Pages: set this in the dashboard under Settings -> Environment
# variables, for BOTH the Production and Preview environments, then redeploy.
# Create React App inlines REACT_APP_* values at BUILD time, not at runtime —
# changing it later has no effect until the site is rebuilt.
#
#   REACT_APP_API_URL=https://salesmotion-api.onrender.com/api
#
# The value must include the trailing /api and must NOT have a trailing slash.
# Whatever origin serves this app also has to be listed in the backend's
# FRONTEND_URL, or the browser blocks every call with a CORS error.
REACT_APP_API_URL=http://localhost:5000/api
